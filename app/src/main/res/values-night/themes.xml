<resources>
    <!-- 深色模式：状态栏图标转浅色（对应 HTML [data-theme="dark"] 仅覆盖 CSS 变量） -->
    <style name="Theme.EarthOnline" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- v1.0.12：系统导航栏透明，交给窗口内容（壁纸）——彻底消除底栏下方白色横条 -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- 深色模式：窗口背景同步深色，避免「系统启动窗口(深) → Compose 首帧」之间的亮色闪帧；
             值与 SplashOverlay 深色变体（#1A1A1A）同源，三段接力依旧同色。 -->
        <item name="android:windowBackground">@color/background_dark</item>
    </style>

    <!-- v1.0.3+：深色 Splash 补齐 android:windowBackground（values-night 是整体替换、不与 values 合并，
         不写就继承 Theme.SplashScreen 默认色 → 冷启动最前一帧露出亮色，出现「白闪」）；
         同时图标改为透明占位（与浅色一致），避免系统层先画一个地球、Compose 开屏页再画一次的重影。 -->
    <style name="Theme.EarthOnline.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_dark</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.EarthOnline</item>
    </style>
</resources>
