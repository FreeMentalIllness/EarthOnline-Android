<?xml version="1.0" encoding="utf-8"?>
<!-- 总览小组件布局。
     RemoteViews 只支持 FrameLayout/LinearLayout/RelativeLayout/GridLayout 与
     少数基础控件（TextView/ImageView/ProgressBar/Chronograph/Adapter 类），
     所以这里没有 Material 组件、没有 ConstraintLayout，圆角一律靠 drawable。
     根布局用 match_parent + center_vertical：不同桌面的格子高度不一致（4x2 从 130dp 到 190dp 都有），
     内容垂直居中可以兼容，不会出现"上半截空一大块"。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/widget_bg">

    <!-- 头部：头像 + 名字 + 等级 + 经验条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <!-- 默认头像（位图 PNG：RemoteViews 对矢量支持不一致，这里只用位图兜底）；
                 上传过头像时由渲染阶段替换成圆形 Bitmap，见 WidgetRenderer.roundAvatar -->
            <ImageView
                android:id="@+id/widget_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_default_avatar"
                android:contentDescription="@string/widget_avatar_desc" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/widget_default_name"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_level"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/widget_text_sub"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_xp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/widget_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_xp_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:minHeight="0dp"
                android:progressDrawable="@drawable/widget_progress" />
        </LinearLayout>
    </LinearLayout>

    <!-- 四个入口：任务 / 背包 / 成就 / 数据 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_entry_tasks"
            style="@style/WidgetEntry">
            <ImageView
                android:id="@+id/widget_icon_tasks"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/widget_entry_tasks" />
            <TextView
                style="@style/WidgetEntryLabel"
                android:text="@string/widget_entry_tasks" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_entry_backpack"
            style="@style/WidgetEntry">
            <ImageView
                android:id="@+id/widget_icon_backpack"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/widget_entry_backpack" />
            <TextView
                style="@style/WidgetEntryLabel"
                android:text="@string/widget_entry_backpack" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_entry_achievements"
            style="@style/WidgetEntry">
            <ImageView
                android:id="@+id/widget_icon_achievements"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/widget_entry_achievements" />
            <TextView
                style="@style/WidgetEntryLabel"
                android:text="@string/widget_entry_achievements" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_entry_data"
            style="@style/WidgetEntry">
            <ImageView
                android:id="@+id/widget_icon_data"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/widget_entry_data" />
            <TextView
                style="@style/WidgetEntryLabel"
                android:text="@string/widget_entry_data" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
